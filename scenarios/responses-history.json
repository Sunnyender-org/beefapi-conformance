{
  "scenarios": [
    {
      "id": "responses-function-history",
      "name": "Responses: stateless function_call / function_call_output history replayed in full (Codex shape)",
      "tier": "pr",
      "kind": "http",
      "protocol": "responses",
      "http_endpoint": "/v1/responses",
      "stream": true,
      "required_capabilities": ["responses", "stream", "tool.custom"],
      "timeout_seconds": 120,
      "requires_local_tools": false,
      "http_payload": {
        "model": "{{model}}",
        "store": false,
        "instructions": "You are a coding agent running in a terminal. Follow instructions exactly.",
        "tools": [{"type": "function", "name": "shell", "description": "Run a shell command.", "parameters": {"type": "object", "properties": {"command": {"type": "array", "items": {"type": "string"}}}, "required": ["command"]}, "strict": false}],
        "input": [
          {"role": "user", "content": [{"type": "input_text", "text": "List the current directory."}]},
          {"type": "function_call", "call_id": "call_hist_01", "name": "shell", "arguments": "{\"command\":[\"ls\",\"-la\"]}"},
          {"type": "function_call_output", "call_id": "call_hist_01", "output": "total 8\ndrwxr-xr-x  2 user  staff  64 marker.txt"},
          {"role": "assistant", "content": [{"type": "output_text", "text": "The directory contains marker.txt."}]},
          {"role": "user", "content": [{"type": "input_text", "text": "{{prompt}}"}]}
        ]
      },
      "turns": [{"prompt": "Reply exactly BEEFAPI_RESPONSES_HISTORY_OK.", "marker": "BEEFAPI_RESPONSES_HISTORY_OK", "expected_events": []}]
    },
    {
      "id": "responses-parallel-function-history",
      "name": "Responses: two function_calls in one turn with both outputs replayed",
      "tier": "pr",
      "kind": "http",
      "protocol": "responses",
      "http_endpoint": "/v1/responses",
      "stream": true,
      "required_capabilities": ["responses", "stream", "tool.custom"],
      "timeout_seconds": 120,
      "requires_local_tools": false,
      "http_payload": {
        "model": "{{model}}",
        "store": false,
        "tools": [{"type": "function", "name": "read_file", "description": "Read a file.", "parameters": {"type": "object", "properties": {"path": {"type": "string"}}, "required": ["path"]}}],
        "input": [
          {"role": "user", "content": [{"type": "input_text", "text": "Read a.txt and b.txt."}]},
          {"type": "function_call", "call_id": "call_par_01", "name": "read_file", "arguments": "{\"path\":\"a.txt\"}"},
          {"type": "function_call", "call_id": "call_par_02", "name": "read_file", "arguments": "{\"path\":\"b.txt\"}"},
          {"type": "function_call_output", "call_id": "call_par_01", "output": "alpha"},
          {"type": "function_call_output", "call_id": "call_par_02", "output": "beta"},
          {"role": "user", "content": [{"type": "input_text", "text": "{{prompt}}"}]}
        ]
      },
      "turns": [{"prompt": "Reply exactly BEEFAPI_RESPONSES_PARALLEL_OK.", "marker": "BEEFAPI_RESPONSES_PARALLEL_OK", "expected_events": []}]
    },
    {
      "id": "responses-reasoning-roundtrip",
      "name": "Responses: real reasoning items with encrypted_content replayed as input (Codex stateless reasoning)",
      "tier": "merge",
      "kind": "http",
      "protocol": "responses",
      "http_endpoint": "/v1/responses",
      "stream": true,
      "required_capabilities": ["responses", "stream", "reasoning"],
      "timeout_seconds": 240,
      "requires_local_tools": false,
      "history_source": {"seed_prompt": "Briefly reason, then say hello in one short sentence.", "thinking": true},
      "turns": [{"prompt": "Reply exactly BEEFAPI_REASONING_ROUNDTRIP_OK.", "marker": "BEEFAPI_REASONING_ROUNDTRIP_OK", "expected_events": []}]
    },
    {
      "id": "responses-previous-response-id",
      "name": "Responses: stateful continuation via previous_response_id",
      "tier": "merge",
      "kind": "http",
      "protocol": "responses",
      "http_endpoint": "/v1/responses",
      "stream": true,
      "required_capabilities": ["responses", "stream", "responses.stateful"],
      "timeout_seconds": 240,
      "requires_local_tools": false,
      "history_source": {"seed_prompt": "Remember the nonce ORANGE-HERON-317 and say OK.", "mode": "previous_response_id"},
      "turns": [{"prompt": "Reply with the nonce you remembered followed by BEEFAPI_PREVIOUS_ID_OK.", "marker": "BEEFAPI_PREVIOUS_ID_OK", "expected_events": ["ORANGE-HERON-317"]}]
    }
  ]
}
