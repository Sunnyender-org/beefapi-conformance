{
  "scenarios": [
    {
      "id": "history-tool-result-image",
      "name": "History: tool_result content mixing text and image blocks (Claude Code screenshot)",
      "tier": "pr",
      "kind": "http",
      "protocol": "messages",
      "http_endpoint": "/v1/messages",
      "stream": true,
      "required_capabilities": [
        "messages",
        "stream",
        "tool.custom"
      ],
      "timeout_seconds": 120,
      "requires_local_tools": false,
      "http_payload": {
        "model": "{{model}}",
        "max_tokens": 256,
        "tools": [
          {
            "name": "take_screenshot",
            "description": "Capture the current browser viewport.",
            "input_schema": {
              "type": "object",
              "properties": {}
            }
          }
        ],
        "messages": [
          {
            "role": "user",
            "content": "Take a screenshot of the page."
          },
          {
            "role": "assistant",
            "content": [
              {
                "type": "text",
                "text": "Capturing the viewport now."
              },
              {
                "type": "tool_use",
                "id": "toolu_hist_img_01",
                "name": "take_screenshot",
                "input": {}
              }
            ]
          },
          {
            "role": "user",
            "content": [
              {
                "type": "tool_result",
                "tool_use_id": "toolu_hist_img_01",
                "content": [
                  {
                    "type": "text",
                    "text": "Screenshot captured (1x1 test pixel)."
                  },
                  {
                    "type": "image",
                    "source": {
                      "type": "base64",
                      "media_type": "image/png",
                      "data": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg=="
                    }
                  }
                ]
              }
            ]
          },
          {
            "role": "user",
            "content": "{{prompt}}"
          }
        ]
      },
      "turns": [
        {
          "prompt": "Reply exactly BEEFAPI_HISTORY_IMAGE_OK.",
          "marker": "BEEFAPI_HISTORY_IMAGE_OK",
          "expected_events": []
        }
      ]
    },
    {
      "id": "history-tool-result-error",
      "name": "History: tool_result with is_error true",
      "tier": "pr",
      "kind": "http",
      "protocol": "messages",
      "http_endpoint": "/v1/messages",
      "stream": true,
      "required_capabilities": [
        "messages",
        "stream",
        "tool.custom"
      ],
      "timeout_seconds": 120,
      "requires_local_tools": false,
      "http_payload": {
        "model": "{{model}}",
        "max_tokens": 256,
        "tools": [
          {
            "name": "run_command",
            "description": "Run a shell command.",
            "input_schema": {
              "type": "object",
              "properties": {
                "command": {
                  "type": "string"
                }
              },
              "required": [
                "command"
              ]
            }
          }
        ],
        "messages": [
          {
            "role": "user",
            "content": "List the directory."
          },
          {
            "role": "assistant",
            "content": [
              {
                "type": "tool_use",
                "id": "toolu_hist_err_01",
                "name": "run_command",
                "input": {
                  "command": "ls /nonexistent"
                }
              }
            ]
          },
          {
            "role": "user",
            "content": [
              {
                "type": "tool_result",
                "tool_use_id": "toolu_hist_err_01",
                "is_error": true,
                "content": "ls: /nonexistent: No such file or directory"
              }
            ]
          },
          {
            "role": "user",
            "content": "{{prompt}}"
          }
        ]
      },
      "turns": [
        {
          "prompt": "Reply exactly BEEFAPI_HISTORY_ERROR_OK.",
          "marker": "BEEFAPI_HISTORY_ERROR_OK",
          "expected_events": []
        }
      ]
    },
    {
      "id": "history-parallel-tools",
      "name": "History: multiple tool_use in one assistant turn with matching tool_results",
      "tier": "pr",
      "kind": "http",
      "protocol": "messages",
      "http_endpoint": "/v1/messages",
      "stream": true,
      "required_capabilities": [
        "messages",
        "stream",
        "tool.custom"
      ],
      "timeout_seconds": 120,
      "requires_local_tools": false,
      "http_payload": {
        "model": "{{model}}",
        "max_tokens": 256,
        "tools": [
          {
            "name": "read_file",
            "description": "Read a file.",
            "input_schema": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                }
              },
              "required": [
                "path"
              ]
            }
          }
        ],
        "messages": [
          {
            "role": "user",
            "content": "Read a.txt and b.txt."
          },
          {
            "role": "assistant",
            "content": [
              {
                "type": "text",
                "text": "Reading both files in parallel."
              },
              {
                "type": "tool_use",
                "id": "toolu_hist_par_01",
                "name": "read_file",
                "input": {
                  "path": "a.txt"
                }
              },
              {
                "type": "tool_use",
                "id": "toolu_hist_par_02",
                "name": "read_file",
                "input": {
                  "path": "b.txt"
                }
              }
            ]
          },
          {
            "role": "user",
            "content": [
              {
                "type": "tool_result",
                "tool_use_id": "toolu_hist_par_01",
                "content": "alpha"
              },
              {
                "type": "tool_result",
                "tool_use_id": "toolu_hist_par_02",
                "content": "beta"
              }
            ]
          },
          {
            "role": "user",
            "content": "{{prompt}}"
          }
        ]
      },
      "turns": [
        {
          "prompt": "Reply exactly BEEFAPI_HISTORY_PARALLEL_OK.",
          "marker": "BEEFAPI_HISTORY_PARALLEL_OK",
          "expected_events": []
        }
      ]
    },
    {
      "id": "history-system-blocks-cache",
      "name": "History: system as block array with cache_control on system, tools and messages",
      "tier": "pr",
      "kind": "http",
      "protocol": "messages",
      "http_endpoint": "/v1/messages",
      "stream": true,
      "required_capabilities": [
        "messages",
        "stream",
        "tool.custom"
      ],
      "timeout_seconds": 120,
      "requires_local_tools": false,
      "http_payload": {
        "model": "{{model}}",
        "max_tokens": 256,
        "system": [
          {
            "type": "text",
            "text": "You are a coding assistant running inside a CLI. Follow instructions exactly."
          },
          {
            "type": "text",
            "text": "Workspace context: a small Python project.",
            "cache_control": {
              "type": "ephemeral"
            }
          }
        ],
        "tools": [
          {
            "name": "noop",
            "description": "Does nothing.",
            "input_schema": {
              "type": "object",
              "properties": {}
            },
            "cache_control": {
              "type": "ephemeral"
            }
          }
        ],
        "messages": [
          {
            "role": "user",
            "content": [
              {
                "type": "text",
                "text": "Hello.",
                "cache_control": {
                  "type": "ephemeral"
                }
              }
            ]
          },
          {
            "role": "assistant",
            "content": "Hello! How can I help?"
          },
          {
            "role": "user",
            "content": "{{prompt}}"
          }
        ]
      },
      "turns": [
        {
          "prompt": "Reply exactly BEEFAPI_HISTORY_CACHE_OK.",
          "marker": "BEEFAPI_HISTORY_CACHE_OK",
          "expected_events": []
        }
      ]
    },
    {
