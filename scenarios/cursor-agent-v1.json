{
  "scenarios": [
    {
      "id": "cursor-v1-usage-quality",
      "name": "Type64 usage quality: observed unknown vs billing estimate",
      "tier": "merge",
      "kind": "http",
      "protocol": "messages",
      "http_endpoint": "/v1/messages",
      "required_capabilities": ["cursor.agent_v1", "text", "messages"],
      "timeout_seconds": 120,
      "requires_local_tools": false,
      "evidence_requirements": ["usage.quality"],
      "turns": [
        {
          "prompt": "Reply exactly BEEFAPI_CURSOR_V1_USAGE_OK.",
          "marker": "BEEFAPI_CURSOR_V1_USAGE_OK",
          "expected_events": []
        }
      ]
    },
    {
      "id": "cursor-v1-tool-catalog-canary",
      "name": "Caller local tools visible; Cursor native shell/fs hidden",
      "tier": "nightly",
      "kind": "client",
      "protocol": null,
      "required_capabilities": ["cursor.agent_v1", "tool.shell"],
      "timeout_seconds": 180,
      "requires_local_tools": true,
      "evidence_requirements": ["tool.catalog"],
      "turns": [
        {
          "prompt": "Use only your caller-local tools to read exactly {{workspace}}/marker.txt. Do not use Cursor native shell or filesystem tools. Then reply exactly BEEFAPI_CURSOR_V1_CATALOG_OK.",
          "marker": "BEEFAPI_CURSOR_V1_CATALOG_OK",
          "expected_events": ["BEEFAPI_CONFORMANCE_FILE_OK"]
        }
      ]
    },
    {
      "id": "cursor-v1-custom-tool-canary",
      "name": "Caller custom tool remains visible on Cursor Agent v1",
      "tier": "merge",
      "kind": "http",
      "protocol": "messages",
      "http_endpoint": "/v1/messages",
      "required_capabilities": ["cursor.agent_v1", "tool.custom", "messages"],
      "timeout_seconds": 120,
      "requires_local_tools": false,
      "evidence_requirements": ["tool.custom.canary"],
      "http_payload": {
        "model": "{{model}}",
        "max_tokens": 128,
        "tools": [
          {
            "name": "beefapi_conformance_canary",
            "description": "Caller-local conformance canary. Echo the marker.",
            "input_schema": {
              "type": "object",
              "properties": {
                "marker": {"type": "string"}
              }
            }
          }
        ],
        "messages": [
          {
            "role": "user",
            "content": "{{prompt}}"
          }
        ]
      },
      "turns": [
        {
          "prompt": "The caller canary tool beefapi_conformance_canary must remain visible. Reply exactly BEEFAPI_CURSOR_V1_CUSTOM_OK.",
          "marker": "BEEFAPI_CURSOR_V1_CUSTOM_OK",
          "expected_events": []
        }
      ]
    },
    {
      "id": "cursor-v1-tool-result-retry-23s",
      "name": "Identical completed tool_result retry at +23s is idempotent",
      "tier": "nightly",
      "kind": "http",
      "protocol": "messages",
      "http_endpoint": "/v1/messages",
      "required_capabilities": ["cursor.agent_v1", "tool.custom", "messages"],
      "timeout_seconds": 120,
      "requires_local_tools": false,
      "retry_offsets_seconds": [23],
      "evidence_requirements": ["tool_result.idempotent"],
      "http_payload": {
        "model": "{{model}}",
        "max_tokens": 128,
        "messages": [
          {"role": "user", "content": "Use the canary tool."},
          {
            "role": "assistant",
            "content": [
              {
                "type": "tool_use",
                "id": "toolu_conformance_retry_23s",
                "name": "beefapi_conformance_canary",
                "input": {"marker": "BEEFAPI_CURSOR_V1_RETRY_23S_OK"}
              }
            ]
          },
          {
            "role": "user",
            "content": [
              {
                "type": "tool_result",
                "tool_use_id": "toolu_conformance_retry_23s",
                "content": "BEEFAPI_CURSOR_V1_RETRY_23S_OK"
              }
            ]
          }
        ]
      },
      "turns": [
        {
          "prompt": "The completed tool_result is already present. Reply exactly BEEFAPI_CURSOR_V1_RETRY_23S_OK.",
          "marker": "BEEFAPI_CURSOR_V1_RETRY_23S_OK",
          "expected_events": []
        }
      ]
    },
