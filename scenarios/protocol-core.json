{
  "scenarios": [
    {
      "id": "responses-text",
      "name": "OpenAI Responses non-stream text",
      "tier": "pr",
      "kind": "http",
      "protocol": "responses",
      "http_endpoint": "/v1/responses",
      "required_capabilities": ["responses", "text"],
      "timeout_seconds": 120,
      "requires_local_tools": false,
      "turns": [{"prompt": "Reply exactly BEEFAPI_RESPONSES_OK.", "marker": "BEEFAPI_RESPONSES_OK", "expected_events": []}]
    },
    {
      "id": "messages-text",
      "name": "Anthropic Messages non-stream text",
      "tier": "pr",
      "kind": "http",
      "protocol": "messages",
      "http_endpoint": "/v1/messages",
      "required_capabilities": ["messages", "text"],
      "timeout_seconds": 120,
      "requires_local_tools": false,
      "turns": [{"prompt": "Reply exactly BEEFAPI_MESSAGES_OK.", "marker": "BEEFAPI_MESSAGES_OK", "expected_events": []}]
    },
    {
      "id": "messages-trailing-system",
      "name": "Anthropic Messages with Claude Code dynamic system context after user",
      "tier": "pr",
      "kind": "http",
      "protocol": "messages",
      "http_endpoint": "/v1/messages",
      "required_capabilities": ["messages", "text", "messages.trailing_system"],
      "timeout_seconds": 120,
      "requires_local_tools": false,
      "http_payload": {
        "model": "{{model}}",
        "max_tokens": 128,
        "system": "x-anthropic-billing-header: cc_version=2.1.233; cc_entrypoint=sdk-cli;",
        "messages": [
          {"role": "user", "content": "{{prompt}}"},
          {
            "role": "system",
            "content": [
              {
                "type": "text",
                "text": "Available agent types and skills for this local Claude Code workspace."
              }
            ]
          }
        ]
      },
      "turns": [{"prompt": "Reply exactly BEEFAPI_TRAILING_SYSTEM_OK.", "marker": "BEEFAPI_TRAILING_SYSTEM_OK", "expected_events": []}]
    },
    {
      "id": "chat-text",
      "name": "OpenAI Chat Completions non-stream text",
      "tier": "pr",
      "kind": "http",
      "protocol": "chat",
      "http_endpoint": "/v1/chat/completions",
      "required_capabilities": ["chat", "text"],
      "timeout_seconds": 120,
      "requires_local_tools": false,
      "turns": [{"prompt": "Reply exactly BEEFAPI_CHAT_OK.", "marker": "BEEFAPI_CHAT_OK", "expected_events": []}]
    }
  ]
}
