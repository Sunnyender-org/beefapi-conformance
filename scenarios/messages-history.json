    {
      "id": "thinking-stream",
      "name": "Extended thinking: signed thinking blocks stream before the answer",
      "tier": "pr",
      "kind": "http",
      "protocol": "messages",
      "http_endpoint": "/v1/messages",
      "stream": true,
      "required_capabilities": [
        "messages",
        "stream",
        "thinking"
      ],
      "timeout_seconds": 180,
      "requires_local_tools": false,
      "http_payload": {
        "model": "{{model}}",
        "max_tokens": 2048,
        "thinking": {
          "type": "enabled",
          "budget_tokens": 1024
        },
        "messages": [
          {
            "role": "user",
            "content": "{{prompt}}"
          }
        ]
      },
      "turns": [
        {
          "prompt": "Think briefly about why the sky is blue, then reply exactly BEEFAPI_THINKING_OK.",
          "marker": "BEEFAPI_THINKING_OK",
          "expected_events": [
            "\"type\":\"thinking\"",
            "signature_delta"
          ]
        }
      ]
    },
    {
