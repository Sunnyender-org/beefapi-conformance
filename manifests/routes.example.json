{
  "routes": [
    {
      "id": "beefapi-cursor-native",
      "name": "BeefAPI Cursor Native canary",
      "auth_mode": "gateway_token",
      "base_url": "https://beefapi.example",
      "token_env": "BEEFAPI_CONFORMANCE_TOKEN",
      "evidence_command_env": "BEEFAPI_CONFORMANCE_EVIDENCE_COMMAND",
      "release_evidence_required": true,
      "clients": ["raw-http", "claude-code", "codex-cli", "grok-build"],
      "protocols": ["messages", "responses", "chat"],
      "capabilities": ["text", "stream", "tool.shell", "tool.custom", "tool.web", "session.resume", "responses", "messages", "chat", "compact", "images"]
    },
    {
      "id": "workbuddy-managed",
      "name": "WorkBuddy managed custom-model route",
      "auth_mode": "managed_session",
      "base_url": null,
      "token_env": null,
      "evidence_command_env": "WORKBUDDY_CONFORMANCE_EVIDENCE_COMMAND",
      "release_evidence_required": true,
      "clients": ["workbuddy-cli"],
      "protocols": ["workbuddy"],
      "capabilities": ["text", "stream", "tool.shell", "tool.web", "session.resume", "acp", "images"]
    }
  ]
}
