    {
      "id": "cursor-v1-covering-set-tool-result",
      "name": "Covering-set tool_result blocks must not 4xx",
      "tier": "merge",
      "kind": "http",
      "protocol": "messages",
      "http_endpoint": "/v1/messages",
      "required_capabilities": ["cursor.agent_v1", "tool.custom", "messages"],
      "timeout_seconds": 120,
      "requires_local_tools": false,
      "evidence_requirements": ["http.not_4xx"],
      "http_payload": {
        "model": "{{model}}",
        "max_tokens": 128,
        "messages": [
          {"role": "user", "content": "Use both canary tools."},
          {
            "role": "assistant",
            "content": [
              {
                "type": "tool_use",
                "id": "toolu_conformance_cover_a",
                "name": "beefapi_conformance_canary",
                "input": {"marker": "A"}
              },
              {
                "type": "tool_use",
                "id": "toolu_conformance_cover_b",
                "name": "beefapi_conformance_canary",
                "input": {"marker": "B"}
              }
            ]
          },
          {
            "role": "user",
            "content": [
              {
                "type": "tool_result",
                "tool_use_id": "toolu_conformance_cover_a",
                "content": "A"
              },
              {
                "type": "tool_result",
                "tool_use_id": "toolu_conformance_cover_b",
                "content": "B"
              }
            ]
          }
        ]
      },
      "turns": [
        {
          "prompt": "Covering tool results are complete. Reply exactly BEEFAPI_CURSOR_V1_COVERING_OK.",
          "marker": "BEEFAPI_CURSOR_V1_COVERING_OK",
          "expected_events": []
        }
      ]
    },
